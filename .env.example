# Bu SHABLON fayl — bu yerga haqiqiy kalit yozmang, u git'ga tushadi!
# Haqiqiy kalitlar faqat .env ichida bo'lsin (u .gitignore da).
# Nusxa olish:  copy .env.example .env

# --- Majburiy ---------------------------------------------------------------
# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=

# --- Xavfsizlik (juda tavsiya etiladi) ---------------------------------------
# Faqat shu ID'lar bot bilan gaplasha oladi. Bo'sh qoldirilsa — hamma gaplasha
# oladi va API xarajati sizdan ketadi. O'z ID'ingizni botga /id yozib bilasiz.
ALLOWED_USER_IDS=

# --- Provayderlar va navbat --------------------------------------------------
# Vergul bilan yozilgan tartib: birinchisi asosiy. Agar uning limiti tugasa yoki
# xato bersa, bot avtomatik keyingisiga o'tadi va javobni o'sha beradi.
# Kaliti kiritilmagan provayder ro'yxatdan o'tkazib yuboriladi.
# Mumkin bo'lganlar: gemini, openai, groq, openrouter, ollama
PROVIDERS=gemini,openai

# Google Gemini — bepul tarifi bor (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI — pullik (platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Groq — bepul tarifi bor, juda tez (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — ba'zi modellari bepul (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama — o'z serveringizda, butunlay bepul (kalit shart emas)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Har bir provayderning manzilini o'zgartirish kerak bo'lsa:
#   <NOM>_BASE_URL=...   masalan GEMINI_BASE_URL=...

# --- Ixtiyoriy ---------------------------------------------------------------
# Bo'sh qoldirilsa so'rovga umuman qo'shilmaydi — shunda hamma provayder bilan
# ishlayveradi. Faqat OpenAI ishlatsangiz javob uzunligini cheklash mumkin.
BOT_MAX_TOKENS=
# Faqat "reasoning" modellar uchun: minimal | low | medium | high
BOT_REASONING_EFFORT=

DEFAULT_TIMEZONE=Asia/Tashkent
DB_PATH=data/assistant.db
# Modelga beriladigan oxirgi xabarlar soni (kam bo'lsa arzonroq)
HISTORY_LIMIT=40
# Bitta qidiruvda nechta natija olinadi
SEARCH_RESULTS=5
